<Window x:Class="SmartCopy.UI.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Copy Selection"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseMove="Window_PreviewMouseMove">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Semi-transparent backdrop when selecting -->
        <Canvas x:Name="OverlayCanvas">
            <!-- Dynamic selection rectangle -->
            <Rectangle x:Name="SelectionRect"
                       Fill="#2238bdf8"
                       Stroke="#38bdf8"
                       StrokeThickness="1.5"
                       StrokeDashArray="3 2"
                       Visibility="Collapsed" />

            <!-- First click marker point -->
            <Ellipse x:Name="StartPointMarker"
                     Width="12"
                     Height="12"
                     Fill="#38bdf8"
                     Stroke="#ffffff"
                     StrokeThickness="2"
                     Visibility="Collapsed" />
        </Canvas>

        <!-- Floating Modern HUD Banner -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,32,0,0"
                CornerRadius="24"
                Background="#E60f172a"
                BorderBrush="#3338bdf8"
                BorderThickness="1"
                Padding="20,10,24,10"
                Effect="{DynamicResource ShadowEffect}">
            <Border.Resources>
                <DropShadowEffect x:Key="ShadowEffect"
                                  BlurRadius="20"
                                  Color="#000000"
                                  Opacity="0.5"
                                  ShadowDepth="4" />
            </Border.Resources>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="#38bdf8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HudText"
                           Text="Click start of text"
                           Foreground="#f8fafc"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI, sans-serif"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  •  "
                           Foreground="#64748b"
                           FontSize="14"
                           VerticalAlignment="Center"/>
                <TextBlock Text="[Esc] or Right-Click to cancel"
                           Foreground="#94a3b8"
                           FontSize="13"
                           FontFamily="Segoe UI, sans-serif"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Toast Notification Pill for Copied Feedback -->
        <Border x:Name="ToastPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,60"
                CornerRadius="20"
                Background="#E610b981"
                BorderBrush="#34d399"
                BorderThickness="1"
                Padding="20,8,24,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✓  " Foreground="#ffffff" FontWeight="Bold" FontSize="14" />
                <TextBlock x:Name="ToastText"
                           Text="Text copied to clipboard!"
                           Foreground="#ffffff"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI, sans-serif"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
